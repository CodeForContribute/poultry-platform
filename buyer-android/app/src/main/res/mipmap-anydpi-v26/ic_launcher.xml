<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive Icon Configuration for Poultry Buyer App

    This defines the adaptive icon using separate foreground and background layers.
    Android 8.0+ (API 26+) will use this configuration for launcher icons.

    The adaptive icon system allows the launcher to:
    - Apply different masks (circle, squircle, rounded square, etc.)
    - Create motion effects with parallax between layers
    - Provide consistent icon presentation across devices
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
